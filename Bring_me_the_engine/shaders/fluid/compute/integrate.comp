#version 430
layout(local_size_x = 128) in;

struct Particle {
    vec4 position; // xyz: pos, w: densité
    vec4 velocity; // xyz: vél, w: pression (inutilisé ici)
};

struct Obstacle {
    mat4 inverseModelMatrix; // Permet de passer du Monde -> Local de l'objet
    vec3 boxMin; // Borne min locale de la texture (padding inclus)
    int textureSlot; // Index du sampler 3D correspondant dans u_sdfTextures
    vec3 boxMax; // Borne max locale de la texture (padding inclus)
    float padding; // Alignement
};

layout(std430, binding = 0) buffer InBuffer {
    Particle particles[];
} inBuf;
layout(std430, binding = 1) buffer OutBuffer {
    Particle particles[];
} outBuf;
layout(std430, binding = 2) buffer ObstacleBuffer {
    Obstacle obstacles[];
};

layout(binding = 4) uniform sampler3D u_sdfTextures[8];

uniform float smoothingRadius;
uniform float stiffness; // Équivalent au "bulk"
uniform float restDensity; // Équivalent au "rho0"
uniform float viscosity; // Équivalent au "visco"
uniform float particleMass;
uniform float dt;
uniform float particleRadius;
uniform float gravity;
uniform vec3 boxMin;
uniform vec3 boxMax;
uniform int particleCount;

uniform int obstacleCount;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= particleCount) return;

    vec3 posI = inBuf.particles[id].position.xyz;
    vec3 velI = inBuf.particles[id].velocity.xyz;
    float densityI = inBuf.particles[id].position.w;

    float h = smoothingRadius;
    float h2 = h * h;
    float pi = 3.14159265;

    float coeff_global = 1.0 / (pi * (h2 * h2));

    vec3 accel_interaction = vec3(0.0);

    for (int j = 0; j < particleCount; j++) {
        if (id == j) continue;

        vec3 posJ = inBuf.particles[j].position.xyz;
        float densityJ = inBuf.particles[j].position.w;
        vec3 velJ = inBuf.particles[j].velocity.xyz;

        vec3 p_ij = posI - posJ;
        float r2 = dot(p_ij, p_ij);

        if (r2 < h2 && r2 > 0.00001) {
            float r = sqrt(r2);
            float q = r / h;

            vec3 v_ij = velI - velJ;
            float one_minus_q = 1.0 - q;
            float safe_q = max(q, 0.01);

            float delta_density = max((densityI + densityJ) - (2.0 * restDensity), 0.0);
            float pressure_term = 15.0 * stiffness * delta_density * one_minus_q / safe_q;
            float viscosity_term = 40.0 * viscosity;

            vec3 parenthese = (p_ij * pressure_term) - (v_ij * viscosity_term);
            float facteur_commun = one_minus_q * coeff_global;

            vec3 f_interact_ij = (particleMass / densityJ) * facteur_commun * parenthese;

            accel_interaction += f_interact_ij / densityI;
        }
    }

    // Intégration physique (Euler semi-implicite)
    vec3 acceleration = accel_interaction + vec3(0.0, gravity, 0.0);
    vec3 newVel = velI + acceleration * dt;
    vec3 newPos = posI + newVel * dt;

    // Collisions avec les frontières (restitution)
    float restitution = 0.5;
    float eps = 0.001;

    if (newPos.x < boxMin.x) {
        newPos.x = boxMin.x + eps;
        newVel.x = -newVel.x * restitution;
    }
    else if (newPos.x > boxMax.x) {
        newPos.x = boxMax.x - eps;
        newVel.x = -newVel.x * restitution;
    }

    if (newPos.y < boxMin.y) {
        newPos.y = boxMin.y + eps;
        newVel.y = -newVel.y * restitution;
    }
    else if (newPos.y > boxMax.y) {
        newPos.y = boxMax.y - eps;
        newVel.y = -newVel.y * restitution;
    }

    if (newPos.z < boxMin.z) {
        newPos.z = boxMin.z + eps;
        newVel.z = -newVel.z * restitution;
    }
    else if (newPos.z > boxMax.z) {
        newPos.z = boxMax.z - eps;
        newVel.z = -newVel.z * restitution;
    }

    // -------------------------------------------------------------
    // GESTION DES COLLISIONS AVEC LES OBSTACLES DE LA SCÈNE
    // -------------------------------------------------------------
    for (int k = 0; k < obstacleCount; k++) {
        Obstacle obs = obstacles[k];

        // On projette la position Monde de la particule dans l'espace Local de l'objet
        vec4 localPos = obs.inverseModelMatrix * vec4(newPos, 1.0);
        vec3 pLocal = localPos.xyz;

        // Étape A : On vérifie par un test AABB rapide si on est dans la zone de la SDF locale
        if (pLocal.x >= obs.boxMin.x && pLocal.x <= obs.boxMax.x &&
                pLocal.y >= obs.boxMin.y && pLocal.y <= obs.boxMax.y &&
                pLocal.z >= obs.boxMin.z && pLocal.z <= obs.boxMax.z) {

            // Étape B : Transformation des coordonnées locales vers l'espace de mapping UVW [0, 1] de la texture 3D
            vec3 sizeLocal = obs.boxMax - obs.boxMin;
            vec3 uvw = (pLocal - obs.boxMin) / sizeLocal;

            // Échantillonnage de la distance signée la plus proche (SDF)
            float distanceToSurface = texture(u_sdfTextures[obs.textureSlot], uvw).r;

            float meshEps = particleRadius * 0.2; // On tolère un petit chevauchement pour éviter les "collisions fantômes"

            // Si la surface de la particule traverse la géométrie du Mesh
            if (distanceToSurface < particleRadius + eps + meshEps) {

                // Étape C : Calcul de la normale locale via le Gradient de la SDF
                // On regarde les pas de variation autour du voxel courant
                float delta = 0.01;
                vec3 grad;
                grad.x = texture(u_sdfTextures[obs.textureSlot], uvw + vec3(delta, 0.0, 0.0)).r - texture(u_sdfTextures[obs.textureSlot], uvw - vec3(delta, 0.0, 0.0)).r;
                grad.y = texture(u_sdfTextures[obs.textureSlot], uvw + vec3(0.0, delta, 0.0)).r - texture(u_sdfTextures[obs.textureSlot], uvw - vec3(0.0, delta, 0.0)).r;
                grad.z = texture(u_sdfTextures[obs.textureSlot], uvw + vec3(0.0, 0.0, delta)).r - texture(u_sdfTextures[obs.textureSlot], uvw - vec3(0.0, 0.0, delta)).r;

                // Le gradient est toujours orienté vers l'extérieur du volume
                vec3 localNormal = (length(grad) > 0.00001) ? normalize(grad) : vec3(0.0, 1.0, 0.0);

                // Étape D : Éjection de la particule le long de la normale locale
                float penetration = (particleRadius + eps + meshEps) - distanceToSurface;
                pLocal += localNormal * penetration;

                // On repasse la position corrigée dans l'espace Monde
                newPos = (inverse(obs.inverseModelMatrix) * vec4(pLocal, 1.0)).xyz;

                // Étape E : On repasse la normale locale dans l'espace Monde pour appliquer la physique
                // On utilise la transposée de la matrice inverse (règle standard des normales)
                // Comme inverseModelMatrix est l'inverse de Model, sa transposée fait l'affaire
                vec3 worldNormal = normalize((vec4(localNormal, 0.0) * obs.inverseModelMatrix).xyz);

                // Application de ton super code de glissement tangentiel avec friction
                float normalVel = dot(newVel, worldNormal);
                vec3 vNormal = worldNormal * normalVel;
                vec3 vTangente = newVel - vNormal;

                float frictionTangente = 0.98;

                if (normalVel < 0.0) {
                    vNormal = -vNormal * restitution;
                }
                newVel = vNormal + (vTangente * frictionTangente);
            }
        }
    }

    // Écriture dans le OutBuffer
    outBuf.particles[id].position = vec4(newPos, densityI);
    outBuf.particles[id].velocity = vec4(newVel, 0.0);
}
